DATABASE_URL="postgresql://miqat:miqat@localhost:5432/miqat?schema=public"
PORT=4000
# The public web app URL — used to build Stripe Checkout's redirect URLs.
APP_URL=http://localhost:3000
# The public backend URL — used to build Paymob's notification_url. Must be
# reachable from the internet (Paymob's servers call it), so local dev
# needs a tunnel (ngrok/cloudflared), not localhost.
BACKEND_URL=http://localhost:4000

# Payment provider — set one at install time
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paymob (Intention API) — from the Paymob dashboard: Secret/Public keys
# under Developers > API Keys, HMAC secret under Developers > Webhooks,
# integration ID under Payment Integrations (the "online card" integration).
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_HMAC_SECRET=

# Reminder channels — leave blank to fall back to console-logged
# reminders (fine for dev, not for production). Any SMTP provider works:
# Gmail, SendGrid, Mailgun, Amazon SES, or your own mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional — powers the "Auto-translate" button in the admin Content
# editor's bilingual (EN/AR) text fields. Without this set, the owner can
# still type both languages by hand; the button is just hidden. Get a key
# from Google Cloud Console (enable the "Cloud Translation API"), usage-
# based billing beyond a small monthly free quota.
GOOGLE_TRANSLATE_API_KEY=

JWT_SECRET=change-me-on-install
